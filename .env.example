# Porch Light Client Environment Variables
# Copy to .env for local overrides if needed

# Frontend Vite Port
PORT=5174

# Stripe Publishable Key (Test Mode: pk_test_...)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_placeholder

# Backend API Root URL
VITE_API_URL=http://localhost:5000/api

