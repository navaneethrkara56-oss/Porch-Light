# ==============================================================================
# Porch Light Backend Environment Configuration Example
# Copy this file to .env and fill in your actual credentials.
# NEVER commit the active .env file to version control.
# ==============================================================================

# Server Runtime
NODE_ENV=development
PORT=5000

# Allowed Frontend Origins (comma-separated for CORS)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# MongoDB Atlas Connection
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@cluster0.example.mongodb.net/porchlight?retryWrites=true&w=majority

# JWT Authentication & Cookie Security
# Generate strong, random secrets (minimum 32 characters)
JWT_SECRET=replace_with_a_secure_random_jwt_secret_at_least_32_chars
JWT_EXPIRES_IN=7d
COOKIE_SECRET=replace_with_a_secure_random_cookie_secret_at_least_32_chars

# Rate Limiting
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20

# Stripe Payments (Test Mode Only)
# Get your test keys from https://dashboard.stripe.com/test/apikeys
# Secret key is STRICTLY SERVER-ONLY
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_placeholder
# Webhook secret from Stripe CLI or Dashboard test webhook endpoint
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret_placeholder
STRIPE_CURRENCY=INR
CLIENT_URL=http://localhost:5174
SERVER_URL=http://localhost:5000

# Google OAuth (Server-side token verification)
# Client ID may be shared with frontend; Client Secret is STRICTLY SERVER-ONLY
GOOGLE_CLIENT_ID=your_google_client_id_placeholder.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_strictly_server_only

# Cloudinary Storage (Server-side signed uploads)
# Cloudinary API Secret is STRICTLY SERVER-ONLY
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret_strictly_server_only

